rules_version = '2';

// Firebase Storage – soubory appky Sulice–Želivec.
// ČTENÍ: jen přihlášený uživatel (Google login v appce). Tím přestávají být PDF/fotky veřejné.
// ZÁPIS: jen přihlášený, do 30 MB, jen obrázky / PDF / JSON (přímý upload z appky přes Storage SDK).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf|application/json');
    }
  }
}
